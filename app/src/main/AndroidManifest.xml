<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for rendering remote web URLs inside the wallpaper engine -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <application
        android:name=".WallpaperApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Web Wallpaper"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar"
        tools:targetApi="31">
        
        <!-- The Settings UI (Jetpack Compose) Entry Point -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Live Wallpaper Engine -->
        <service
            android:name=".service.LiveWallpaperService"
            android:exported="true"
            android:label="Web Wallpaper Engine"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <!-- Points to the XML file that defines this service as a wallpaper -->
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

    </application>
</manifest>
